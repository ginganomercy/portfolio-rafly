---
import MusicPlayer from '../components/MusicPlayer.svelte';

export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
	</head>
	<body class="bg-slate-50 text-slate-800 font-sans antialiased selection:bg-blue-200" style="font-family: 'Inter', sans-serif;">
		<!-- Sticky Header -->
		<header class="fixed top-0 w-full z-50 bg-white/80 backdrop-blur-md border-b border-slate-200">
			<div class="max-w-6xl mx-auto px-6 h-16 grid grid-cols-2 sm:grid-cols-3 items-center">
				<div class="flex justify-start">
					<a href="#" class="text-xl font-bold text-blue-600 tracking-tight">RAFLY<span class="text-slate-800"> ASHRAFFI</span></a>
				</div>
				<nav class="hidden sm:flex justify-center gap-8 text-sm font-semibold text-slate-600">
					<a href="#about" class="relative hover:text-blue-600 transition-colors group">
						About
						<span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-blue-600 transition-all group-hover:w-full"></span>
					</a>
					<a href="#skills" class="relative hover:text-blue-600 transition-colors group">
						Skills
						<span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-blue-600 transition-all group-hover:w-full"></span>
					</a>
					<a href="#projects" class="relative hover:text-blue-600 transition-colors group">
						Projects
						<span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-blue-600 transition-all group-hover:w-full"></span>
					</a>
					<a href="#contact" class="relative hover:text-blue-600 transition-colors group">
						Contact
						<span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-blue-600 transition-all group-hover:w-full"></span>
					</a>
				</nav>
				<div class="flex justify-end">
					<!-- Right side header area -->
				</div>
			</div>
		</header>
		<div class="pt-16">
			<slot />
		</div>
		<MusicPlayer client:load />
	</body>
</html>
<style is:global>
	html {
		scroll-padding-top: 5rem; /* Account for the fixed header height */
	}
</style>
